# Google Analytics 4. Sin esta variable, el componente de GA no se renderiza
# y el sitio funciona igual. La política de cookies se adapta sola.
NEXT_PUBLIC_GA_ID=

# URL pública del sitio, SIN barra final. De aquí salen los canonical, el
# sitemap, robots.txt, el JSON-LD y las imágenes de Open Graph: tiene que
# coincidir con el dominio donde está desplegado.
# Si se deja vacía, se usa https://drdavidtorres.com.
NEXT_PUBLIC_SITE_URL=https://drdavidtorres.com

# Reseñas de Google en la portada (API de Places, «Places API (New)»).
# Solo de servidor: SIN el prefijo NEXT_PUBLIC_, para que la clave no llegue
# nunca al navegador. Sin ella, la sección de opiniones muestra solo los
# botones para escribir y leer reseñas en Google, y no rompe nada.
# En Google Cloud: restringir la clave a «Places API (New)».
GOOGLE_PLACES_API_KEY=
